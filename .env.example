CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_PORT=5678
CLIO_AUTH_URL= https://app.clio.com/oauth/authorize #https://eu.app.clio.com/oauth/authorize
CLIO_TOKEN_URL=https://app.clio.com/oauth/token #https://eu.app.clio.com/oauth/token
CLIO_API_BASE=https://app.clio.com/api/v4 #https://eu.app.clio.com/api/v4
CLIO_REGION=us # ca, eu, or au
# Optional: overrides OS keychain (use for CI/headless installs)
ENCRYPTION_KEY=
# ESQ production default is empty/read-only. Enabling names advertises only
# explicitly allowlisted, confirmation-gated tools; broad legacy writes stay hidden.
ESQ_WRITE_TOOLS=
ESQ_CLIO_UPLOAD_ROOT=
ESQ_FIRM_TIMEZONE=America/Toronto
TRANSPORT= 
MCP_BASE_URL=http://127.0.0.1:3000
# Required whenever TRANSPORT is not stdio. Use a long random secret.
MCP_API_KEY=
